PORT=8787
CORS_ORIGIN=http://localhost:5173,http://localhost:8000

# 可选的 Supabase 配置。若不填写，后端会继续使用内存模式。
# 注意：这里必须使用 service_role key。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 登录验证码/安全验证默认开启；临时关闭时改为 false。
AUTH_CHALLENGE_ENABLED=true

# 可选的 Turnstile 配置。生产环境建议填写真实 key。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
